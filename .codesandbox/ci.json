{
  "packages": [
    "packages/react",
    "packages/react-dom",
    "packages/react-is",
    "packages/react-server-dom-turbopack",
    "packages/react-server-dom-webpack",
    "packages/scheduler"
  ],
  "installCommand": "install:csb",
  "buildCommand": "download-build-in-codesandbox-ci",
  "node": "20",
